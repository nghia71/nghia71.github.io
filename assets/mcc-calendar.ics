---
layout: null
permalink: /assets/mcc-calendar.ics
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//MCC Math Club and Competitions//Club calendar//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:MCC club calendar
{% for e in site.data.calendar %}{% if e.ics %}BEGIN:VEVENT
UID:mcc-{{ e.id }}@nghia71.github.io
DTSTAMP:{{ site.time | date: "%Y%m%dT%H%M%SZ" }}
{% if e.ics.start contains "T" %}DTSTART:{{ e.ics.start }}
DTEND:{{ e.ics.end }}
{% else %}DTSTART;VALUE=DATE:{{ e.ics.start }}
DTEND;VALUE=DATE:{{ e.ics.end }}
{% endif %}SUMMARY:{{ e.ics.summary }}
URL:{{ e.ics.url }}
END:VEVENT
{% endif %}{% endfor %}END:VCALENDAR
